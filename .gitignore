# Keep directory structure and small audit/scorecard artifacts tracked
!data/inbound/.gitkeep
!data/processing/.gitkeep
!data/archive/.gitkeep
!data/rejects/.gitkeep
!data/archive/scorecards/*.csv
!data/archive/vendor_sla_history.csv

